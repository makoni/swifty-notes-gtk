msgid "Swifty Notes"
msgstr "Swifty Notes"

msgid "Sergey Armodin"
msgstr "Sergey Armodin"

msgid "Native GTK markdown notes with preview and automation"
msgstr "プレビューと自動化に対応した、ネイティブ GTK の Markdown ノート"

msgid "notes"
msgstr "ノート"

msgid "markdown"
msgstr "markdown"

