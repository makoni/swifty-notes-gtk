msgid "Swifty Notes"
msgstr "Swifty Notes"

msgid "Sergey Armodin"
msgstr "Sergey Armodin"

msgid "Native GTK markdown notes with preview and automation"
msgstr "미리 보기와 자동화를 갖춘 네이티브 GTK 마크다운 노트"

msgid "notes"
msgstr "노트"

