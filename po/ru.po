msgid "Settings"
msgstr "Настройки"

msgid ""
"Show :shortcode: aliases (e.g. :rocket:) as emoji. Source text and code are "
"unchanged."
msgstr ""
"Отображать псевдонимы :shortcode: (например, :rocket:) как эмодзи. Исходный "
"текст и код остаются без изменений."

msgid "Show Notes Sidebar"
msgstr "Показать боковую панель заметок"

msgid "Show outline (F9)"
msgstr "Показать структуру (F9)"

msgid "Show the drag affordance on hover. Drag-to-reorder ships separately."
msgstr ""
"Показывать индикатор перетаскивания при наведении. Перетаскивание для "
"изменения порядка реализуется отдельно."

msgid "Size"
msgstr "Размер"

msgid "Sort Notes"
msgstr "Сортировать заметки"

msgid "Sort Notes by Newest First"
msgstr "Сортировать заметки: сначала новые"

msgid "Sort Notes by Oldest First"
msgstr "Сортировать заметки: сначала старые"

msgid "Sort Notes by Title"
msgstr "Сортировать заметки по названию"

msgid "Sort by Title"
msgstr "Сортировать по названию"

msgid "Sorting by %@"
msgstr "Сортировка по %@"

msgid "Spaces"
msgstr "Пробелы"

msgid "Spell check"
msgstr "Проверка орфографии"

msgid "Spell-check language"
msgstr "Язык проверки орфографии"

msgid "Split"
msgstr "Разделить"

msgid "Split view"
msgstr "Разделённый вид"

msgid "Storage"
msgstr "Хранилище"

msgid ""
"Swifty Notes does not have permission to access that folder. Try choosing a "
"different location."
msgstr ""
"У Swifty Notes нет разрешения на доступ к этой папке. Попробуйте выбрать "
"другое расположение."

msgid "Swifty Notes is up to date."
msgstr "Swifty Notes не требует обновлений."

msgid "Tab width"
msgstr "Ширина табуляции"

msgid "Table"
msgstr "Таблица"

msgid "Tabs"
msgstr "Табуляция"

msgid "Task List"
msgstr "Список задач"

msgid "The application instance is not available."
msgstr "Экземпляр приложения недоступен."

msgid "The current notes folder could not be found."
msgstr "Текущая папка заметок не найдена."

msgid "The new notes folder cannot be inside the current notes folder."
msgstr "Новая папка заметок не может находиться внутри текущей папки заметок."

msgid "The note title is derived from the first meaningful line."
msgstr "Название заметки берётся из первой содержательной строки."

msgid "The selected destination is not a folder."
msgstr "Выбранное назначение не является папкой."

msgid ""
"The selected folder is on a read-only filesystem and cannot store notes."
msgstr ""
"Выбранная папка находится на файловой системе, предназначенной только для "
"чтения, и не может хранить заметки."

msgid "There is not enough disk space to move your notes to that folder."
msgstr "На диске недостаточно места для перемещения заметок в эту папку."

msgid ""
"This permanently removes the note from disk. This action can't be undone."
msgstr "Это навсегда удалит заметку с диска. Это действие нельзя отменить."

msgid "Title"
msgstr "Название"

msgid "Toggle Outline"
msgstr "Показать структуру"

msgid "Trash"
msgstr "Корзина"

msgid "Trash emptied"
msgstr "Корзина очищена"

msgid "Tree lines under H2 sections"
msgstr "Древовидные линии под разделами H2"

msgid "Turn the current line into a heading"
msgstr "Превратить текущую строку в заголовок"

msgid ""
"Tweak the right-hand outline panel and the breadcrumb strip above the editor."
msgstr ""
"Настройте правую панель структуры и навигационную полоску над редактором."

msgid ""
"Underline misspellings while you type and offer corrections in the right-"
"click menu."
msgstr ""
"Подчёркивать ошибки орфографии при вводе и предлагать исправления в "
"контекстном меню."

msgid "Undo"
msgstr "Отменить"

msgid "Unknown CLI command: %@"
msgstr "Неизвестная команда CLI: %@"

msgid "Unknown command for help: %@"
msgstr "Неизвестная команда для справки: %@"

msgid "Unknown folders subcommand: %@"
msgstr "Неизвестная подкоманда для папок: %@"

msgid "Unknown option: %@"
msgstr "Неизвестный параметр: %@"

msgid "Unsaved changes"
msgstr "Несохранённые изменения"

msgid "Unsupported image type for %@."
msgstr "Неподдерживаемый тип изображения для %@."

msgid "Update"
msgstr "Обновить"

msgid "Use / to create nested folders in one step, e.g. Work/Drafts."
msgstr ""
"Используйте / для создания вложенных папок за один шаг, например, Работа/"
"Черновики."

msgid "Use default location"
msgstr "Использовать расположение по умолчанию"

msgid "Use only one of --content, --content-file, or --stdin."
msgstr "Используйте только один из: --content, --content-file или --stdin."

msgid "Version %@ is available."
msgstr "Доступна версия %@."

msgid "Vertical guides linking H3+ subsections to their H2 parent."
msgstr "Вертикальные линии, связывающие подразделы H3+ с родительским H2."

msgid "Whole Word Match"
msgstr "Целое слово"

msgid "Wrap long lines"
msgstr "Переносить длинные строки"

msgid "Wrap markdown paragraphs instead of scrolling horizontally."
msgstr "Переносить абзацы markdown вместо горизонтальной прокрутки."

msgid "Wrap the selection in bold markdown"
msgstr "Обернуть выделение полужирным markdown"

msgid "Wrap the selection in italic markdown"
msgstr "Обернуть выделение курсивом markdown"

msgid "`folders create` requires exactly one folder path."
msgstr "Для `folders create` необходимо указать ровно один путь к папке."

msgid "`folders move <path> --to <parent>` requires both a path and a parent."
msgstr ""
"Для `folders move <path> --to <parent>` необходимо указать и путь, и "
"родительскую папку."

msgid "`folders move` accepts exactly one folder path."
msgstr "Для `folders move` необходимо указать ровно один путь к папке."

msgid "`folders rename` requires <path> <new-name>."
msgstr "Для `folders rename` необходимо указать <path> <new-name>."

msgid "`folders rm` accepts exactly one folder path."
msgstr "Для `folders rm` необходимо указать ровно один путь к папке."

msgid "`folders rm` cannot delete the root."
msgstr "Команда `folders rm` не может удалить корень."

msgid "`folders rm` requires a folder path."
msgstr "Для `folders rm` необходимо указать путь к папке."

msgid "`get` expects exactly one note ID."
msgstr "Для `get` необходимо указать ровно один ID заметки."

msgid "`get` requires a note ID."
msgstr "Для `get` необходимо указать ID заметки."

msgid "`help` accepts at most one command name."
msgstr "Для `help` можно указать не более одного имени команды."

msgid "`move` expects exactly one note ID."
msgstr "Для `move` необходимо указать ровно один ID заметки."

msgid "`move` requires --folder PATH (use --folder \"\" to move to the root)."
msgstr ""
"Для `move` необходимо указать --folder <путь> (используйте --folder \"\", "
"чтобы переместить в корень)."

msgid "`move` requires a note ID."
msgstr "Для `move` необходимо указать ID заметки."

msgid "`update` requires a note ID."
msgstr "Для `update` необходимо указать ID заметки."

msgid "current"
msgstr "текущий"

msgid "“%@” is in the Trash"
msgstr "«%@» находится в корзине"

msgid "“You are here” strip above the editor toolbar."
msgstr "Полоска «Вы здесь» над панелью инструментов редактора."

msgid "↑↓ navigate · ↵ jump · Esc close"
msgstr "↑↓ навигация · ↵ переход · Esc закрытие"

